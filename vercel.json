{
  "rewrites": [
    {
      "source": "/reports/:file.html",
      "destination": "/api/report?file=:file.html"
    }
  ],
  "redirects": [
    {
      "source": "/analyza/octavia-combi/",
      "destination": "/analyza/skoda-octavia/",
      "permanent": true
    },
    {
      "source": "/analyza/octavia-combi",
      "destination": "/analyza/skoda-octavia/",
      "permanent": true
    },
    {
      "source": "/reports/octavia-combi-analyza.html",
      "destination": "/reports/skoda-octavia-analyza.html",
      "permanent": true
    },
    {
      "source": "/analyza/skoda-octavia-combi/",
      "destination": "/analyza/skoda-octavia/",
      "permanent": true
    },
    {
      "source": "/analyza/skoda-octavia-combi",
      "destination": "/analyza/skoda-octavia/",
      "permanent": true
    },
    {
      "source": "/reports/skoda-octavia-combi-analyza.html",
      "destination": "/reports/skoda-octavia-analyza.html",
      "permanent": true
    }
  ],
  "functions": {
    "api/report.js": {
      "includeFiles": "{private/reports/**,public/reports/**,src/data/access.json}"
    }
  }
}
